PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/CRMS
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_password

# SMTP settings used to deliver reset links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com

# Private evidence upload storage and maximum accepted file size (bytes).
# Keep this directory outside all publicly served client/server directories.
EVIDENCE_STORAGE_DIR=./private-evidence
EVIDENCE_UPLOAD_MAX_BYTES=10485760
